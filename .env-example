# ──────────────────────────────────────────────────────────────
#  LemonSec QA Automation — Environment Configuration
#  Developer: Govind Pratap Singh
# ──────────────────────────────────────────────────────────────

# ── LLM Configuration ────────────────────────────────────────
LLM_MODEL_NAME=gpt-4o
LLM_MODEL_API_KEY=PUT_YOUR_MODEL_API_KEY_HERE

# For GPT-5 models, use max_completion_tokens instead of max_tokens
# LLM_MODEL_MAX_COMPLETION_TOKENS=4096

# If you want to use a JSON file for multi-agent LLM config:
# AGENTS_LLM_CONFIG_FILE=agents_llm_config.json
# AGENTS_LLM_CONFIG_FILE_REF_KEY=lemonsec-default

# ── Browser Configuration ────────────────────────────────────
BROWSER_TYPE=chromium
HEADLESS=false
BROWSER_RESOLUTION=1920,1080
# BROWSER_COOKIES=[{"name": "session", "value": "abc123", "domain": "example.com", "path": "/"}]

# ── Recording & Proofs ───────────────────────────────────────
RECORD_VIDEO=false
TAKE_SCREENSHOTS=true
CAPTURE_NETWORK=true

# ── Remote Browser (CDP) ─────────────────────────────────────
# CDP_ENDPOINT_URL=ws://localhost:9222/devtools/browser/<id>

# BrowserStack:
# BROWSERSTACK_USERNAME=your_username
# BROWSERSTACK_ACCESS_KEY=your_access_key

# LambdaTest:
# LAMBDATEST_USERNAME=your_username
# LAMBDATEST_ACCESS_KEY=your_access_key

# ── Runtime ──────────────────────────────────────────────────
TOKENIZERS_PARALLELISM=false
MODE=prod
HF_HOME=./.cache

# ── Python Sandbox ───────────────────────────────────────────
# SANDBOX_TENANT_ID=executor_agent
